# ~/.config/skhd/skhdrc
# SUPER key = ctrl + alt + cmd

.blacklist [
    "UTM"
]

# ============================================
# Applications
# ============================================

# SUPER + Return : Kitty
ctrl + alt + cmd - return : open -n -a "kitty"

# SUPER + B : Brave Browser
ctrl + alt + cmd - b : open -n -a "Brave Browser"

# SUPER + E : Finder (équivalent Nautilus)
ctrl + alt + cmd - e : /Applications/Marta.app/Contents/MacOS/Marta -n

# SUPER + R : Obsidian
ctrl + alt + cmd - r : open -a "Obsidian"

# SUPER + C : Editor
ctrl + alt + cmd - c : /opt/homebrew/bin/zed -n

# SUPER + P : Spotify
ctrl + alt + cmd - p : open -a "Spotify"

# ============================================
# Window Management
# ============================================

# SUPER + Q : Fermer fenêtre
ctrl + alt + cmd - q : yabai -m window --close
# mega kill
ctrl + alt + cmd + shift - q : osascript -e 'tell application "System Events" to set frontApp to name of first application process whose frontmost is true' -e 'quit app frontApp'

ctrl + alt + cmd - f : yabai -m window --toggle zoom-fullscreen

# SUPER + SPACE : Toggle float
ctrl + alt + cmd - space : yabai -m window --toggle float

# SUPER + V : Toggle split (vertical/horizontal)
ctrl + alt + cmd - v : yabai -m window --toggle split

# ============================================
# Window Focus (flèches)
# ============================================

ctrl + alt + cmd - left : yabai -m window --focus west
ctrl + alt + cmd - down : yabai -m window --focus south
ctrl + alt + cmd - up : yabai -m window --focus north
ctrl + alt + cmd - right : yabai -m window --focus east

# ============================================
# Window Focus (vim style hjkl)
# ============================================

ctrl + alt + cmd - h : yabai -m window --focus west
ctrl + alt + cmd - j : yabai -m window --focus south
ctrl + alt + cmd - k : yabai -m window --focus north
ctrl + alt + cmd - l : yabai -m window --focus east

# ============================================
# Window Move/Swap (SHIFT + flèches)
# ============================================

ctrl + alt + cmd + shift - left : yabai -m window --swap west
ctrl + alt + cmd + shift - down : yabai -m window --swap south
ctrl + alt + cmd + shift - up : yabai -m window --swap north
ctrl + alt + cmd + shift - right : yabai -m window --swap east

# ============================================
# Window Resize (ALT + flèches)
# ============================================

ctrl + alt + cmd + shift - h : yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0
ctrl + alt + cmd + shift - j : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50
ctrl + alt + cmd + shift - k : yabai -m window --resize top:0:-50 || yabai -m window --resize bottom:0:-50
ctrl + alt + cmd + shift - l : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0

# ============================================
# Workspaces (Spaces 1-5)
# ============================================

# SUPER + 1-5 : Focus workspace
ctrl + alt + cmd - 1 : yabai -m space --focus 1
ctrl + alt + cmd - 2 : yabai -m space --focus 2
ctrl + alt + cmd - 3 : yabai -m space --focus 3
ctrl + alt + cmd - 4 : yabai -m space --focus 4
ctrl + alt + cmd - 5 : yabai -m space --focus 5

# SUPER + PgUp/PgDn : Previous / next workspace (Corne LOWER)
ctrl + alt + cmd - pageup : yabai -m space --focus prev
ctrl + alt + cmd - pagedown : yabai -m space --focus next

# SUPER + SHIFT + 1-5 : Move window to workspace
ctrl + alt + cmd + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
ctrl + alt + cmd + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
ctrl + alt + cmd + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
ctrl + alt + cmd + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
ctrl + alt + cmd + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5

# ============================================
# Special Workspaces
# ============================================

# SUPER + S : Toggle special workspace (macOS n'a pas de scratchpad, on utilise un Space dédié)
ctrl + alt + cmd - s : ~/.config/skhd/scratchpad_toggle.sh
ctrl + alt + cmd + shift - s : yabai -m window --space 5

# ============================================
# Mouse bindings (définis dans yabairc)
# ============================================
# CTRL + left click : move window
# CTRL + right click : resize window

# ============================================
# Yabai/skhd controls
# ============================================

ctrl + alt + cmd - tab : yabai -m window --focus next || yabai -m window --focus first

# Cycle entre fenêtres de la même app
# TODO: "SUPER" is not an skhd modifier, this line broke config parsing
# SUPER - 1 : ~/.config/skhd/cycle_clockwise.sh
#~/.config/karabiner/toggle_same_app.sh

# SUPER + SHIFT + R : Restart yabai
ctrl + alt + cmd + shift - r : yabai --restart-service

# SUPER + SHIFT + E : Restart skhd
ctrl + alt + cmd + shift - e : skhd --restart-service

# SUPER + Escape : Lock session
ctrl + alt + cmd - escape : osascript -e 'tell application "System Events" to keystroke "q" using {command down, control down}'

# SUPER + SHIFT + Escape : Sleep (veille)
ctrl + alt + cmd + shift - escape : pmset sleepnow

# echo "skhd configuration loaded.."
